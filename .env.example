# Copy to .env for local use. NEVER commit .env.
STAFF_PASSWORD=choose-a-strong-password

# Leave these two empty to use local JSON files; fill both to use Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Browser push notifications (optional, all three or none).
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
